# ── This file is used by docker-compose only ─────────────────────────────────
# Copy this file, rename it to .env.docker, and fill in your real values.
# Do NOT commit .env.docker to version control.

DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

GROQ_API_KEY=your-groq-api-key-here
